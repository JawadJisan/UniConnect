# Copy to frontend/.env.local.

# Where Next.js proxies /api/* (server-side only, never sent to the browser).
API_ORIGIN=http://localhost:4000

# The same value as the API's PROXY_SHARED_SECRET (docs/DECISIONS.md D46). Server-side only:
# src/proxy.ts sends it with the visitor's IP on every /api/* request. Required in production.
PROXY_SHARED_SECRET=
