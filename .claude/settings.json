{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm format:check)",
      "Bash(pnpm --filter @uniconnect/shared build)",
      "Bash(pnpm --filter @uniconnect/backend test *)",
      "Bash(pnpm --filter @uniconnect/frontend test *)",
      "Bash(pnpm --filter @uniconnect/frontend lint)",
      "Bash(pnpm --filter @uniconnect/backend exec prisma validate)",
      "Bash(pnpm --filter @uniconnect/backend db:generate)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "ask": [
      "Bash(pnpm --filter @uniconnect/backend db:migrate *)",
      "Bash(pnpm --filter @uniconnect/backend exec prisma migrate *)",
      "Bash(pnpm --filter @uniconnect/backend db:deploy *)",
      "Bash(pnpm --filter @uniconnect/backend db:seed *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(neon *)",
      "Bash(git commit *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.test)",
      "Read(**/.env.production)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Bash(*prisma migrate reset*)",
      "Bash(*prisma db push*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)"
    ]
  }
}
