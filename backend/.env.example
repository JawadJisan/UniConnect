# Copy to backend/.env and fill in. Never commit real values.

# --- Server ---
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# --- Database (Neon) ---
# `neon checkout <branch>` writes these two (plus NEON_BRANCH*) into backend/.env.
# Use the development branch locally; production only gets `prisma migrate deploy`.
# DATABASE_URL: pooled (-pooler host), used by the app at runtime.
# DATABASE_URL_UNPOOLED: direct, used by the Prisma CLI (migrate, studio).
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require

# Integration tests (`pnpm test:integration`) and `db:test:deploy` use the Neon `test` branch.
# Fill these from `neon connection-string test --pooled` and `neon connection-string test`.
# scripts/with-test-db.mjs refuses to run if they are empty or point at the development host.
TEST_DATABASE_URL=
TEST_DATABASE_URL_UNPOOLED=

# --- Redis (Upstash) ---
# TLS is required, so the scheme is rediss://. Eviction must be off for BullMQ.
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379

# --- Better Auth ---
# At least 32 characters. Generate one with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# The browser-facing origin (the Next.js app), not the API. /api/auth/* is reached through
# its rewrite, so email links and the session cookie stay first-party.
BETTER_AUTH_URL=http://localhost:3000

# --- Seed (pnpm db:seed) ---
# The platform owner account. The password must meet the registration password policy.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=Super Admin

# --- Email (Nodemailer) ---
# Leave SMTP_HOST empty in development to print emails (with their links) to the console.
# All SMTP_* values except SMTP_PORT are required in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments (DECISIONS D32) ---
# `mock` (default) fakes SSLCommerz for development and tests and is refused in production.
# `sslcommerz` is not implemented yet; the SSLCOMMERZ_* values below are for that gateway.
PAYMENT_GATEWAY=mock
# --- SSLCommerz ---
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# --- Gemini ---
# Both optional outside production; without them the AI routes answer 503. Model ID: see
# docs/DECISIONS.md D44 (e.g. a current stable Flash model). Required in production.
GEMINI_API_KEY=
GEMINI_MODEL=

# Per-email auth rate limits (sign-in 10/15 min, resend 1/5 min, reset 3/h). Keep `on`; only the
# Playwright API (frontend/playwright.config.ts) sets `off`. Refused in production.
AUTH_EMAIL_LIMITS=on
