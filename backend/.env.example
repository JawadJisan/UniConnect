# Copy to backend/.env and fill in. Never commit real values.

# --- Server ---
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# --- Database (docker-compose defaults; development only) ---
# DATABASE_URL: runtime connection, pooled in production.
# DIRECT_URL: Prisma CLI and migrations, never pooled.
DATABASE_URL=postgresql://uniconnect:uniconnect_dev@localhost:5432/uniconnect
DIRECT_URL=postgresql://uniconnect:uniconnect_dev@localhost:5432/uniconnect

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Better Auth ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Email (Nodemailer) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SSLCommerz ---
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=
